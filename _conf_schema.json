{
  "enabled": {
    "type": "bool",
    "description": "启用反混淆还原",
    "hint": "开启后，在消息推向用户前将特定占位符还原为真实词汇。",
    "default": true
  },
  "auto_inject_prompt": {
    "type": "bool",
    "description": "自动注入暗号规则",
    "hint": "开启后，请求模型前会自动在系统提示词尾部静默追加转义代号指引，无需手动修改人设或提示词。",
    "default": true
  },
  "log_restorations": {
    "type": "bool",
    "description": "输出还原日志",
    "hint": "在终端/控制台打印每次命中并还原的替换词数量与详情。",
    "default": true
  },
